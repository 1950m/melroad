<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량용(AAOS) 앱. 휴대폰 화면 방향·Wi-Fi 등 차량에 없을 수 있는 기능은 요구하지 않는다. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- Media3 세션 서비스의 미디어 재생 포그라운드 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- AAOS 차량 속도(PERF_VEHICLE_SPEED). 런타임 허용이 필요한 권한이다. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!--
        Pleos FusedLocation 권한(pleos.car.permission.FUSED_LOCATION)은 어댑터를 실제로 연결할 때 추가한다.
        사용하지 않는 권한을 미리 선언하지 않는다.
    -->

    <application
        android:name=".MelroadApp"
        android:allowBackup="false"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Melroad">

        <!-- Pleos 음악/오디오 앱 가이드: 런처 노출 -->
        <meta-data
            android:name="androidx.car.app.launchable"
            android:value="true" />

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- 주행 중에도 표시 가능한 화면. 대신 CarUxRestrictions에 따라 조작을 직접 제한한다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <meta-data
                android:name="androidx.car.app.launchable"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MBS 호환: Media3 MediaLibraryService + MediaBrowserService 액션 -->
        <service
            android:name=".audio.MelroadMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
